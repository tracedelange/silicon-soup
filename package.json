{
  "name": "mmo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx --env-file=.env server/index.ts",
    "gardener": "tsx pipeline/gardener.ts",
    "implementer": "tsx pipeline/implementer.ts",
    "loop": "tsx pipeline/loop.ts",
    "render-zone": "tsx pipeline/renderZone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gen": "tsx tools/test-generators.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "zone-editor": "tsx tools/zone-editor/server.ts",
    "ability-editor": "tsx tools/ability-editor/server.ts",
    "loot-lab": "tsx tools/loot-lab/server.ts",
    "sprite-lab": "tsx tools/sprite-lab/server.ts",
    "sprite-coverage": "tsx tools/sprite-coverage.ts",
    "biome-workbench": "tsx tools/biome-workbench/server.ts",
    "world-map": "tsx tools/world-map/server.ts",
    "world-gen": "tsx tools/world-gen/server.ts",
    "forge": "tsx forge/server.ts",
    "mob-forge": "tsx --env-file=.env tools/mob-forge.ts",
    "mob-forge:batch": "tsx --env-file=.env tools/mob-forge-batch.ts",
    "mob-forge:explore": "tsx --env-file=.env tools/mob-forge-explore.ts",
    "mob-candidates:build": "tsx tools/mob-candidates-build.ts",
    "forge:stage": "tsx forge/stage.ts",
    "forge:init-world": "tsx forge/grow/init.ts",
    "forge:grow": "tsx forge/grow/grow.ts",
    "forge:grow:live": "FORGE_LIVE=1 tsx --env-file=.env forge/grow/grow.ts",
    "forge:grow:ollama": "FORGE_LIVE=1 PIPELINE_BASE_URL=https://ollama.com PIPELINE_MODEL=${PIPELINE_MODEL:-gemma4:31b-cloud} tsx --env-file=.env forge/grow/grow.ts",
    "forge:live": "FORGE_LIVE=1 tsx --env-file=.env forge/server.ts",
    "forge:ollama": "FORGE_LIVE=1 PIPELINE_BASE_URL=https://ollama.com PIPELINE_MODEL=${PIPELINE_MODEL:-gemma4:31b-cloud} tsx --env-file=.env forge/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p pipeline && tsc --noEmit -p tools",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@anthropic-ai/sdk": "^0.104.1",
    "@octokit/webhooks": "^14.2.0",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^4.0.1",
    "express": "^4.21.0",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "js-yaml": "^4.1.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
