{
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*", "../shared/**/*"],
  // Unit tests are Node-side (they read world/*.yaml off disk) and never ship
  // in the bundle; the root tsconfig is what type-checks them.
  "exclude": ["../shared/**/*.test.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  }
}
